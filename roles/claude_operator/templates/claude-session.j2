#!/usr/bin/env bash
{{ ansible_managed | comment }}
# Start or reattach a Claude Code session that survives an SSH disconnect.
#
# This is a thin wrapper, on purpose. Claude Code creates git worktrees itself
# ("--worktree"), so the wrapper only resolves a project name to a directory,
# works out the multi repository case, keeps the permission mode consistent and
# runs the tmux session Claude lives in.
#
# There is no systemd unit on this host and that is deliberate: a
# "claude remote-control" server has no local terminal, and an always running one
# is a standing remote execution channel into a machine holding a full scope
# credential. tmux keeps the session alive AND keeps a terminal attached to it,
# and the interactive form of Remote Control reconnects by itself after a network
# outage, where server mode gives up after about ten minutes.

set -euo pipefail

WORK="${HOME}/{{ claude_operator_workspace_dirname }}"
CLAUDE="{{ claude_operator_bin }}"
PERMISSION_MODE="{{ claude_operator_permission_mode }}"

{# Everything below is bash, and bash's "${#array[@]}" opens a jinja comment.
   Rendering stops here so the two languages cannot collide - every variable this
   template substitutes is assigned above. #}
{% raw %}

usage() {
  cat <<'USAGE'
claude-session - start or reattach a tmux hosted Claude Code session

  claude-session                        pick a live session, arrows and Enter
  claude-session <project>              attach the project's session, or start one
  claude-session <project> <worktree>   new git worktree, in its own tmux session
  claude-session --no-remote <project> [...]   the same, without Remote Control

Options:
  --no-remote     start the session without Remote Control. By default a new
                  session can be driven from claude.ai/code or the Claude
                  mobile app, which stores its transcript on Anthropic's
                  servers; the session keeps running here, the device is a
                  window, not a runtime. Only a starting session takes the
                  flag - attaching keeps what the session was started with.
  -h, --help      this text

Without a terminal, or with no live session, it lists projects and sessions.

A project is a directory under the workspace root. If it is a git repository,
that is the session's working directory. If it CONTAINS repositories, the first
one is the working directory and every sibling is passed as --add-dir, so one
session sees the whole set - that is the multi repository case.

Three things worth knowing, because each costs an afternoon otherwise:

  * "--worktree" refuses a project whose trust dialog has not been accepted -
    trust in the workspace root does not count. Start "claude-session <project>"
    once and accept it before asking for a worktree.
  * A new worktree is a new path, so it gets its OWN workspace trust dialog.
    Accept it once, in that directory.
  * Session history is keyed to the working directory, under
    ~/.claude/projects/<path with every non alphanumeric character replaced by
    ->. A worktree therefore has its own history, and "claude --continue" in one
    never finds the other's. "claude --resume <id>" resolves from anywhere on
    this host.

"--worktree" branches the repository it runs in. Git has no cross repository
worktree, so in a multi repository project only the primary repository is
branched; the others are added read-write as they are.
USAGE
}

remote=1
while [ $# -gt 0 ]; do
  case "$1" in
    --no-remote) remote=0; shift ;;
    -h|--help)   usage; exit 0 ;;
    --)          shift; break ;;
    -*)          printf 'claude-session: unknown option: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
    *)           break ;;
  esac
done

if [ ! -d "$WORK" ]; then
  printf 'claude-session: no workspace root at %s\n' "$WORK" >&2
  exit 1
fi

# ---- no arguments: pick a live session, or show what there is -------------
# Arrow keys (or j/k) move, Enter attaches, q or Esc leaves. The list is drawn
# on stderr and keys are read from stdin, so it needs a terminal on both; a
# pipe or a plain "ssh <host> claude-session" gets the listing below instead.
pick_session() {
  local -a names=() labels=()
  local name label
  while IFS=$'\t' read -r name label; do
    names+=("$name")
    labels+=("$label")
  done < <(tmux list-sessions -F '#{session_name}	#{session_windows} window(s)#{?session_attached, - attached,}' 2>/dev/null || true)
  [ "${#names[@]}" -gt 0 ] || return 1

  local n="${#names[@]}" sel=0 i key rest
  # The cursor is hidden while the list is up, and must come back on every
  # way out - an EXIT trap would not do, exec replaces the shell without one.
  trap 'printf "\033[?25h\n" >&2; exit 130' INT TERM
  printf '\033[?25l' >&2
  printf 'live tmux sessions - arrows to move, Enter to attach, q to leave:\n' >&2
  while :; do
    for ((i = 0; i < n; i++)); do
      if [ "$i" -eq "$sel" ]; then
        printf '\r\033[K\033[7m > %s \033[0m %s\n' "${names[i]}" "${labels[i]}" >&2
      else
        printf '\r\033[K   %s  %s\n' "${names[i]}" "${labels[i]}" >&2
      fi
    done
    IFS= read -rsn1 key || key=q
    if [ "$key" = $'\033' ]; then
      # An arrow is ESC [ A, or ESC O A in application cursor mode. A lone Esc
      # has nothing following it within the timeout.
      rest=
      IFS= read -rsn2 -t 0.05 rest || true
      key+="$rest"
    fi
    case "$key" in
      $'\033[A'|$'\033OA'|k) sel=$(( (sel + n - 1) % n )) ;;
      $'\033[B'|$'\033OB'|j) sel=$(( (sel + 1) % n )) ;;
      '')                    break ;;   # Enter - read -n1 swallows the newline
      q|$'\033')             printf '\033[?25h' >&2; exit 0 ;;
    esac
    printf '\033[%dA' "$n" >&2   # back to the top of the list, redraw in place
  done
  printf '\033[?25h' >&2
  trap - INT TERM

  # From inside tmux an attach would nest one tmux in another.
  if [ -n "${TMUX:-}" ]; then
    exec tmux switch-client -t "=${names[sel]}"
  fi
  exec tmux attach-session -t "=${names[sel]}"
}

if [ $# -eq 0 ]; then
  if [ -t 0 ] && [ -t 2 ]; then
    pick_session || true
  fi

  # Collected into variables rather than piped into "grep -q": with pipefail a
  # short circuiting reader makes the whole pipeline fail, and an empty list
  # would be indistinguishable from a broken one.
  projects="$(find "$WORK" -mindepth 1 -maxdepth 1 -type d -printf '  %f\n' | sort)"
  sessions="$(tmux list-sessions 2>/dev/null | sed 's/^/  /' || true)"

  printf 'projects in %s:\n' "$WORK"
  if [ -n "$projects" ]; then
    printf '%s\n' "$projects"
  else
    printf '  (none yet - create one and clone into it)\n'
  fi

  printf '\nlive tmux sessions:\n'
  if [ -n "$sessions" ]; then
    printf '%s\n' "$sessions"
  else
    printf '  (none)\n'
  fi
  exit 0
fi

project="$1"; shift
worktree="${1:-}"

# ---- clipboard: the display this connection forwards ----------------------
# The xclip shim carries copy and image paste to the operator's desktop over
# the display recorded here. profile.d records it for a login shell already;
# this covers "ssh -t <host> claude-session <project>", which starts none.
if [ -n "${DISPLAY:-}" ]; then
  display_state="${XDG_CACHE_HOME:-$HOME/.cache}/claude-session"
  mkdir -p "$display_state"
  printf '%s\n' "$DISPLAY" > "$display_state/display"
fi

dir="$WORK/$project"
if [ ! -d "$dir" ]; then
  printf 'claude-session: no such project: %s\n' "$dir" >&2
  exit 1
fi

# ---- resolve the working directory and the multi repository case -----------
# "-e" rather than "-d" on .git: in a worktree it is a file, not a directory.
add_dirs=()
if [ -e "$dir/.git" ]; then
  cwd="$dir"
else
  repos=()
  while IFS= read -r repo; do
    repos+=("$repo")
  done < <(find "$dir" -mindepth 1 -maxdepth 1 -type d -exec test -e '{}/.git' ';' -print | sort)
  if [ "${#repos[@]}" -gt 0 ]; then
    cwd="${repos[0]}"
    for repo in "${repos[@]:1}"; do
      add_dirs+=(--add-dir "$repo")
    done
  else
    cwd="$dir"
  fi
fi

args=(--permission-mode "$PERMISSION_MODE")
if [ "$remote" -eq 1 ]; then
  args+=(--remote-control)
fi
if [ "${#add_dirs[@]}" -gt 0 ]; then
  args+=("${add_dirs[@]}")
fi

# tmux closes a session the moment its only pane exits, and a Claude that fails
# to start would take its error message with it - the command then just looks
# like it returned. On a non-zero exit the pane waits for Enter instead.
on_failure='|| { s=$?; printf "\nclaude exited with status %s - press Enter to close\n" "$s"; read -r _; }'

# ---- a worktree of its own: Claude Code makes the tree, tmux the session ----
# Not "claude --worktree --tmux": that runs the tmux client as a CHILD of a
# Claude process, which outlives a detach - Ctrl-b d then leaves a blinking
# cursor until Ctrl-C. So tmux is exec'ed here, as for the project session,
# and Claude runs inside it, making or reusing the worktree. The session name
# and environment are the ones "--tmux" uses, so sessions it started are still
# found and Claude still knows which of its keys the tmux prefix takes.
if [ -n "$worktree" ]; then
  if [ ! -e "$cwd/.git" ]; then
    printf 'claude-session: not a git repository, so it cannot be branched: %s\n' "$cwd" >&2
    exit 1
  fi
  session="$(basename "$cwd")_worktree-$worktree"
  session="${session//[\/.]/_}"
  prefix="$(tmux show-options -gv prefix 2>/dev/null || true)"
  prefix="${prefix:-C-b}"
  case "$prefix" in
    C-b|C-c|C-d|C-t|C-o|C-r|C-s|C-g|C-e) conflicts=1 ;;
    *) conflicts= ;;
  esac
  command_line="$(printf '%q ' "$CLAUDE" --worktree "$worktree" "${args[@]}")"
  command_line+="$on_failure"
  exec tmux new-session -A -s "$session" -c "$cwd" \
    -e "CLAUDE_CODE_TMUX_SESSION=$session" \
    -e "CLAUDE_CODE_TMUX_PREFIX=$prefix" \
    -e "CLAUDE_CODE_TMUX_PREFIX_CONFLICTS=$conflicts" \
    "$command_line"
fi

# ---- the project's own session --------------------------------------------
# tmux session names cannot carry every character a path can.
session="${project//[^a-zA-Z0-9_-]/-}"

if tmux has-session -t "=$session" 2>/dev/null; then
  exec tmux attach-session -t "=$session"
fi

# tmux takes the command as ONE argument and re-splits it, so quote it back
# together rather than passing an argv.
command_line="$(printf '%q ' "$CLAUDE" "${args[@]}")"
command_line+="$on_failure"
exec tmux new-session -s "$session" -c "$cwd" "$command_line"
{% endraw %}
