{{ ansible_managed | comment }}
[Unit]
Description=signal-cli daemon (JSON-RPC / REST api on {{ signal_cli_http_host }}:{{ signal_cli_http_port }})
Documentation=https://github.com/AsamK/signal-cli
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ signal_cli_user }}
Group={{ signal_cli_group }}
ExecStart={{ signal_cli_bin_link }} --config {{ signal_cli_data_dir }}{% if signal_cli_account %} --account {{ signal_cli_account }}{% endif %} daemon --http {{ signal_cli_http_host }}:{{ signal_cli_http_port }} --receive-mode {{ signal_cli_receive_mode }} --no-receive-stdout{% if signal_cli_ignore_attachments %} --ignore-attachments{% endif %}

Restart=on-failure
RestartSec=10
UMask=0077

# The configuration directory stays read only for the service, only the state
# directory is writable.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths={{ signal_cli_data_dir }}
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
{% for mount in signal_cli_foreign_read_mounts %}

# Read only view of {{ mount.overlay }}: an empty tmpfs hides it, then only the
# listed dirs are bound back in, so the daemon reads exactly those by their real
# path. The "-" makes a still missing source non-fatal (it is created later on a
# first install); this unit is restarted once it exists.
TemporaryFileSystem={{ mount.overlay }}
{% for path in mount.paths %}
BindReadOnlyPaths=-{{ path }}
{% endfor %}
{% endfor %}

[Install]
WantedBy=multi-user.target
